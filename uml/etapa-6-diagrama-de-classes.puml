
@startuml

left to right direction

class Main {
    +main(args: list[str]): None
}

class Menu {
    -scanner: TextIO
    -emExecucao: bool
    -jogador: Jogador
    -cidade: Cidade
    -mercado: Mercado
    -agricultura: Agricultura
    -governo: Governo
    -construcoes: Construcoes

    +executar(): None
    -exibirOpcoes(): None
    -lerOpcao(): int
    -processarOpcao(opcao: int): None
    -iniciarNovoJogo(): None
    -exibirStatus(): None
    -abrirMercado(): None
    -lerQuantidade(): int
    -comprarGraos(): None
    -venderGraos(): None
    -comprarTerras(): None
    -venderTerras(): None
    -abrirAgricultura(): None
    -colher(): None
    -distribuirAlimentos(): None
    -abrirGoverno(): None
    -arrecadarImpostos(): None
    -definirTaxaImposto(): None
    -definirJustica(): None
    -abrirConstrucoes(): None
    -recrutarSoldados(): None
    -construir(): None
    -exibirSobre(): None
}

class Jogador {
    -nome: str
    -titulo: str

    +getNome(): str
    +getTitulo(): str
    +setTitulo(titulo: str): None
}

class Cidade {
    -nome: str
    -anoAtual: int
    -dono: Jogador
    -florins: int
    -terras: int
    -graos: int
    -servos: int
    -taxaImposto: int
    -nivelJustica: str
    -soldados: int
    -construcoes: int

    +getNome(): str
    +getAnoAtual(): int
    +getDono(): Jogador
    +getFlorins(): int
    +getTerras(): int
    +getGraos(): int
    +getServos(): int
    +getTaxaImposto(): int
    +setTaxaImposto(taxa: int): None
    +getNivelJustica(): str
    +setNivelJustica(nivel: str): None
    +getSoldados(): int
    +getConstrucoes(): int
    +avancarAno(): None
    +adicionarFlorins(qtd: int): None
    +removerFlorins(qtd: int): bool
    +adicionarTerras(qtd: int): None
    +removerTerras(qtd: int): bool
    +adicionarGraos(qtd: int): None
    +removerGraos(qtd: int): bool
    +adicionarServos(qtd: int): None
    +removerServos(qtd: int): bool
    +adicionarSoldados(qtd: int): None
    +removerSoldados(qtd: int): bool
    +adicionarConstrucoes(qtd: int): None
    +removerConstrucoes(qtd: int): bool
    +exibirStatus(): None
}

class Mercado {
    -PRECO_GRAO: int
    -PRECO_TERRA: int

    +getPrecoGrao(): int
    +getPrecoTerra(): int
    +comprarGraos(cidade: Cidade, qtd: int): bool
    +venderGraos(cidade: Cidade, qtd: int): bool
    +comprarTerras(cidade: Cidade, qtd: int): bool
    +venderTerras(cidade: Cidade, qtd: int): bool
}

class Agricultura {
    -HECTARES_POR_SERVO: int
    -RENDIMENTO_POR_HECTARE: int
    -SERVOS_POR_GRAO: int
    -CRESCIMENTO_PERCENTUAL: int
    -PERCENTUAL_MINIMO: int
    -PERCENTUAL_MAXIMO: int

    +processarColheita(cidade: Cidade): int
    +distribuirAlimentos(cidade: Cidade, percentual: int): bool
}

class Governo {
    -TAXA_MAXIMA: int
    -MULTIPLICADOR_JUSTA: float
    -MULTIPLICADOR_MODERADA: float
    -MULTIPLICADOR_SEVERA: float

    +arrecadarImpostos(cidade: Cidade): int
    +definirTaxaImposto(cidade: Cidade, taxa: int): bool
    +definirJustica(cidade: Cidade, nivel: str): bool
    -multiplicadorPara(nivel: str): float
}

class Construcoes {
    -PRECO_SOLDADO: int
    -SERVOS_POR_SOLDADO: int
    -PRECO_CONSTRUCAO: int

    +recrutarSoldados(cidade: Cidade, qtd: int): bool
    +construir(cidade: Cidade, qtd: int): bool
    +getPrecoSoldado(): int
    +getPrecoConstrucao(): int
}

Main ..> Menu : cria e usa

Menu --> Jogador
Menu --> Cidade
Menu --> Mercado
Menu --> Agricultura
Menu --> Governo
Menu --> Construcoes

Cidade --> "1" Jogador : dono

Mercado ..> Cidade : parâmetro
Agricultura ..> Cidade : parâmetro
Governo ..> Cidade : parâmetro
Construcoes ..> Cidade : parâmetro

@enduml
